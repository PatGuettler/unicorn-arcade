; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-2846735043546429~3696195593"

[application]

config/name="Unicorn Arcade"
run/main_scene="res://scenes/startup.tscn"
config/auto_accept_quit=false
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.039, 0.09, 1)
boot_splash/image="res://assets/startup/unicorn_alley_opening_frame_v1.png"
config/icon="res://icon.png"

[autoload]

SaveService="*res://autoload/save_service.gd"
RewardService="*res://autoload/reward_service.gd"
GameRegistry="*res://autoload/game_registry.gd"
AppState="*res://autoload/app_state.gd"
CompanionAbilityService="*res://autoload/companion_ability_service.gd"
SafeArea="*res://autoload/safe_area.gd"
AccessibleUI="*res://autoload/accessible_ui.gd"
AdBarService="*res://autoload/ad_bar_service.gd"
GameExperience="*res://autoload/game_experience.gd"
RouteService="*res://autoload/route_service.gd"
LegacyReactImport="*res://autoload/legacy_react_import.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://addons/admob/gdscript/sample/translations/admob_sample.en.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.pt_BR.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.es.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.zh_CN.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.ja.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.039, 0.09, 1)
