config_version=5

[application]

config/name="Unicorn Arcade"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

SaveService="*res://autoload/save_service.gd"
RewardService="*res://autoload/reward_service.gd"
GameRegistry="*res://autoload/game_registry.gd"
AppState="*res://autoload/app_state.gd"

[display]

[display/window]

size/viewport_width=720
size/viewport_height=1280
size/window_width_override=450
size/window_height_override=800
stretch/mode="canvas_items"
stretch/aspect="expand"
handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.039, 0.09, 1)
