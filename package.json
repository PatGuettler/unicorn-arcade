{
  "name": "unicorn-arcade",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:verify": "npm run build && node scripts/verify-pages-build.mjs",
    "preview": "vite preview",
    "preview:gh-pages": "npm run build && vite preview --open",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:responsive": "playwright test e2e/responsive.spec.js",
    "test:visual": "playwright test e2e/visual.spec.js",
    "build:android": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease",
    "export:godot-data": "node scripts/export-godot-data.mjs",
    "build:godot": "npm run export:godot-data && godot --headless --path godot --import && godot --headless --path godot res://tests/runtime_smoke.tscn",
    "build:godot:android": "npm run build:godot && mkdir -p build/godot && godot --headless --path godot --install-android-build-template --export-release Android ../build/godot/unicorn-arcade.aab"
  },
  "dependencies": {
    "@capacitor/android": "5.7.8",
    "@capacitor/app": "5.0.8",
    "@capacitor/core": "5.7.8",
    "@capacitor/status-bar": "5.0.8",
    "lucide-react": "^0.292.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "5.7.8",
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "minimatch": "^9.0.5",
    "glob": {
      "minimatch": "^9.0.5"
    },
    "@xmldom/xmldom": "^0.9.0",
    "brace-expansion": "^2.0.3",
    "picomatch": "^4.0.4",
    "rollup": "^4.59.0"
  }
}
